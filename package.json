    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "node scripts/check-package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "bench": "node scripts/proxy-bench.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "3.9.10"
