{
  "name": "edge-direct-switch",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Keep your proxy on and let the current website connect directly (Edge and Chrome)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack.mjs",
